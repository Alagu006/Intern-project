{
  "info": {
    "name": "Secure File Sharing — Module 6 (Admin)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:5000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('admin_token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@secure-files.local\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users?page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "per_page", "value": "20"}
              ]
            }
          }
        },
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users?search=alice",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users"],
              "query": [
                {"key": "search", "value": "alice"}
              ]
            }
          }
        },
        {
          "name": "Filter by Role",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users?role=admin",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users"],
              "query": [
                {"key": "role", "value": "admin"}
              ]
            }
          }
        },
        {
          "name": "Get User Detail",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Disable User",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users/{{user_id}}/disable",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "{{user_id}}", "disable"]
            }
          }
        },
        {
          "name": "Enable User",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/users/{{user_id}}/enable",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "users", "{{user_id}}", "enable"]
            }
          }
        }
      ]
    },
    {
      "name": "File Management",
      "item": [
        {
          "name": "List All Files",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/files?page=1&per_page=20&sort=size",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "files"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "per_page", "value": "20"},
                {"key": "sort", "value": "size"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Storage",
      "item": [
        {
          "name": "Get Storage Usage",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/storage",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "storage"]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "View Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-logs?page=1&per_page=50",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-logs"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "per_page", "value": "50"}
              ]
            }
          }
        },
        {
          "name": "Filter by Action",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-logs?action=download",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-logs"],
              "query": [
                {"key": "action", "value": "download"}
              ]
            }
          }
        },
        {
          "name": "Filter by Date Range",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-logs?start_date=2026-01-01&end_date=2026-12-31",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-logs"],
              "query": [
                {"key": "start_date", "value": "2026-01-01"},
                {"key": "end_date", "value": "2026-12-31"}
              ]
            }
          }
        },
        {
          "name": "Export Audit Logs CSV",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/audit-logs/export",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "audit-logs", "export"]
            }
          }
        }
      ]
    },
    {
      "name": "Statistics",
      "item": [
        {
          "name": "Get Summary Stats",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats", "summary"]
            }
          }
        },
        {
          "name": "Get Uploads Chart (7d)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats/charts?metric=uploads&range=7d",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats", "charts"],
              "query": [
                {"key": "metric", "value": "uploads"},
                {"key": "range", "value": "7d"}
              ]
            }
          }
        },
        {
          "name": "Get Downloads Chart (30d)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats/charts?metric=downloads&range=30d",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats", "charts"],
              "query": [
                {"key": "metric", "value": "downloads"},
                {"key": "range", "value": "30d"}
              ]
            }
          }
        },
        {
          "name": "Get Storage Chart (90d)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats/charts?metric=storage&range=90d",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats", "charts"],
              "query": [
                {"key": "metric", "value": "storage"},
                {"key": "range", "value": "90d"}
              ]
            }
          }
        },
        {
          "name": "Get Activity Chart (7d)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats/charts?metric=activity&range=7d",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats", "charts"],
              "query": [
                {"key": "metric", "value": "activity"},
                {"key": "range", "value": "7d"}
              ]
            }
          }
        }
      ]
    }
  ]
}
