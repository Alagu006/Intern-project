DATABASE_URL=postgresql://postgres:password@localhost:5432/secure_files
SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
UPLOAD_FOLDER=/var/secure_files
BASE_URL=https://localhost:5000
RATELIMIT_STORAGE_URI=memory://
MAX_UPLOAD_SIZE_MB=100
# 32 random bytes, base64-encoded. Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEK=change-this-to-a-base64-encoded-32-byte-key-in-production
# Allowed CORS origins (comma-separated list, e.g. http://localhost:3000,http://localhost:5173). Never use "*" as the API requires credentials/Authorization headers.
ALLOWED_ORIGINS=http://localhost:3000
# Enable interactive Swagger UI docs at /api/docs and spec at /api/openapi.yaml (default false in production, true in testing/dev)
ENABLE_API_DOCS=false
# ClamAV malware scanning before encryption (strongly recommended in production; false by default for local dev)
SCAN_UPLOADS=false
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT=10.0
# Per-user storage quota in MB (default: 500; set to 0 or leave empty for unlimited)
DEFAULT_USER_QUOTA_MB=500


